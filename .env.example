# ========================================================================
# .env.example — Template de variables d'environnement
# ========================================================================
# À COMMITER sur GitHub (sans les vraies valeurs)
# Chaque développeur copie ce fichier en .env et remplit les vraies valeurs
#
# Commande :
# cp .env.example .env
# (Ne jamais commiter .env — voir .gitignore)
# ========================================================================

# ========================================================================
# JWT — Authentification JSON Web Token
# ========================================================================
# JWT_SECRET = clé secrète pour signer les tokens (min 32 caractères)
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change_me_in_prod_use_32_char_minimum
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15

# ========================================================================
# URLS DES SERVICES — Configuration Docker Compose
# ========================================================================
# En Docker : les services se découvrent par hostname (réseau interne)
# En dev local : localhost:8000
BACKEND_URL=ws://backend:8000
VEHICLE_ID=taxi_42
OPERATOR_ID=operator_001

# ========================================================================
# TLS / mTLS — Certificats et clés
# ========================================================================
# Chemins vers les certificats (générés par OpenSSL)
# À ignorer : la clé privée (.key) ne doit JAMAIS être commitée
TLS_CERT_PATH=./technical/certs/server.crt
TLS_KEY_PATH=./technical/certs/server.key
CA_CERT_PATH=./technical/certs/ca.crt
CLIENT_CERT_PATH=./technical/certs/client.crt
CLIENT_KEY_PATH=./technical/certs/client.key

# ========================================================================
# MONITORING — Prometheus et Grafana
# ========================================================================
# Ports d'accès (à travers les conteneurs)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ========================================================================
# SEUILS DE LATENCE — Thème 2 (Attaques et Défense)
# ========================================================================
# Seuils pour déclencher les alertes et le fail-safe
LATENCY_WARN_MS=250              # Avertissement (latence anormale)
LATENCY_CRITICAL_MS=500          # Critique (qualité dégradée)
LATENCY_FAILSAFE_MS=700          # Fail-safe (arrêt auto du véhicule)

# ========================================================================
# BASE DE DONNÉES (futur — pour la persistence des sessions)
# ========================================================================
# DATABASE_URL=postgresql://user:pass@db:5432/teleop_db

# ========================================================================
# LOGGING
# ========================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
